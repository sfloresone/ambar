---
type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<section class="flex flex-col gap-4">
  <div class="flex flex-col gap-1">
    <h2 class="text-xl tracking-tight">{title}</h2>
    {description && <p class="max-w-2xl text-sm text-muted-foreground">{description}</p>}
  </div>
  <div class="grid gap-4 xl:grid-cols-2">
    <slot />
  </div>
</section>
