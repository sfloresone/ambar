---
import { getImage } from "astro:assets";
import clipPoster from "@/assets/moments/sky-through-leaves-2.jpeg";
import { MomentDemo } from "@/components/moment-demo.tsx";
import { skyPhoto } from "@/lib/onboarding.ts";

// Resized WebP: the original is ~500 KB. The photo is the one the onboarding uses (shared file).
const clipImage = await getImage({ src: clipPoster, width: 920, format: "webp", quality: 72 });
---

<section id="try" aria-labelledby="try-title" class="flex scroll-mt-24 flex-col gap-8">
  <div class="flex flex-col gap-3">
    <h2 id="try-title" class="text-3xl tracking-tight sm:text-4xl">Try it</h2>
    <p class="max-w-xl text-pretty text-muted-foreground">
      Keep a moment and decide who sees it. Nothing leaves this page.
    </p>
  </div>
  <MomentDemo client:visible photoSrc={skyPhoto} clipPosterSrc={clipImage.src} />
</section>
