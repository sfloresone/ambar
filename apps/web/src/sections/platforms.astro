---
import { PlatformCards, type PlatformCard } from "@/components/platform-cards.tsx";

const platforms: PlatformCard[] = [
  {
    icon: "globe",
    name: "Web",
    status: "At launch",
    text: "Keep and revisit your moments from any browser. Everything you keep elsewhere is waiting here, in one place.",
  },
  {
    icon: "puzzle",
    name: "Browser extension",
    status: "At launch",
    text: "Keep a page, an image or a link in one click while you browse, without leaving what you are doing.",
  },
  {
    icon: "mobile",
    name: "Mobile",
    status: "Later",
    text: "Keep a moment straight from the camera or the share menu, the second it happens. Android first.",
  },
  {
    icon: "desktop",
    name: "Desktop",
    status: "Later",
    text: "A dedicated app, one shortcut away, for the moments that happen on your screen.",
  },
];
---

<section id="platforms" aria-labelledby="platforms-title" class="flex scroll-mt-24 flex-col gap-8">
  <div class="flex flex-col gap-3">
    <h2 id="platforms-title" class="text-3xl tracking-tight sm:text-4xl">Wherever the moment happens</h2>
    <p class="max-w-xl text-pretty text-muted-foreground">Two doors at launch, two more on the way.</p>
  </div>
  <PlatformCards client:visible platforms={platforms} />
</section>
