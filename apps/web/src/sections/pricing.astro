---
import AmberSpecimen from "@/components/amber-specimen.astro";
import { PricingPlans } from "@/components/pricing-plans.tsx";
import { plans } from "@ambar/core";
import { appUrl } from "@/lib/app-url.ts";
import { apiUrl } from "@/lib/api-url.ts";
import { onboardingBackdrop } from "@/lib/onboarding.ts";
---

<section id="pricing" aria-labelledby="pricing-title" class="flex scroll-mt-24 flex-col gap-8">
  <div class="flex flex-col gap-3">
    <h2 id="pricing-title" class="text-3xl tracking-tight sm:text-4xl">Room for your moments</h2>
    <p class="max-w-xl text-pretty text-muted-foreground">
      Start with {plans[0]?.name}. When you need more room, {plans[1]?.name} gives you plenty of it.
    </p>
  </div>

  <PricingPlans client:visible plans={plans} appUrl={appUrl} onboardingBackdrop={onboardingBackdrop} apiUrl={apiUrl}>
    <AmberSpecimen slot="seed" size="sprout" />
    <AmberSpecimen slot="leaf" size="leaf" />
  </PricingPlans>

  <dl class="grid gap-6 border-t pt-8 text-sm sm:grid-cols-2">
    <div class="flex flex-col gap-1.5">
      <dt class="font-medium">What is a reading?</dt>
      <dd class="text-pretty text-muted-foreground">
        Ámbar reads the words in your photos so you can find them later by what they say.
      </dd>
    </div>
    <div class="flex flex-col gap-1.5">
      <dt class="font-medium">What happens at the limit?</dt>
      <dd class="text-pretty text-muted-foreground">
        We let you know at 80%. At the limit, new moments pause. Nothing is ever deleted, and
        everything you kept stays visible.
      </dd>
    </div>
  </dl>
</section>
