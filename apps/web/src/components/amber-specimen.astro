---
import { Button } from "@ambar/ui/components/button";
import { Image } from "astro:assets";
import leafCloud from "@/assets/pricing/leaf-cloud.webp";
import leafInk from "@/assets/pricing/leaf-ink.webp";
import sproutCloud from "@/assets/pricing/sprout-cloud.webp";
import sproutInk from "@/assets/pricing/sprout-ink.webp";
import surfaceMapUrl from "@/assets/pricing/surface-map.png?url";

type Props = {
  size?: "sprout" | "leaf";
  surface?: "cloud" | "ink";
};

const { size = "leaf", surface = "cloud" } = Astro.props;

const posters = { sprout: { cloud: sproutCloud, ink: sproutInk }, leaf: { cloud: leafCloud, ink: leafInk } };
---

<div data-amber-specimen data-amber-size={size} data-amber-surface={surface} data-amber-map={surfaceMapUrl} class="relative mx-auto aspect-square w-full max-w-56">
  <div data-amber-drop aria-hidden="true" class="absolute inset-0">
    <Image
      data-amber-poster
      src={posters[size][surface]}
      alt=""
      width={336}
      height={336}
      widths={[224, 336]}
      sizes="224px"
      format="webp"
      quality={80}
      loading="lazy"
      class="absolute inset-0 size-full"
    />
  </div>
  <Button
    data-amber-control
    hidden
    tone="cloud"
    aria-label="Press the amber drop"
    className="absolute top-[8%] right-[14%] bottom-[10%] left-[14%] h-auto w-auto touch-pan-y rounded-[50%_52%_48%_50%/58%_50%_50%_42%] bg-transparent p-0 shadow-none hover:brightness-100 active:translate-y-0 active:shadow-none motion-reduce:hidden [&[hidden]]:hidden"
  />
</div>
