---
import { FirstMomentDialog } from "@ambar/ui/components/first-moment-dialog";
import { PILL_BRAND, PILL_HEADER, PILL_HEADER_WRAP, PILL_LINK } from "@ambar/ui/lib/layout";
import { apiUrl } from "@/lib/api-url.ts";
import { appUrl } from "@/lib/app-url.ts";
import Wordmark from "@/components/wordmark.astro";

const home = Astro.url.pathname === "/" ? "" : "/";

const links = [
  { href: `${home}#features`, label: "Features" },
  { href: `${home}#platforms`, label: "Platforms" },
  { href: `${home}#pricing`, label: "Pricing" },
];
---

<!-- Floating glass pill, shared with the app (see @ambar/ui/lib/layout). -->
<header class={PILL_HEADER_WRAP}>
  <div class={PILL_HEADER}>
    <!--
      Reading progress: the pill's own edge is traced in leaf as the page scrolls.
      The pill is h-14 (56px) so the capsule radius is exact: rx = ry = 28. A large rx would be
      clamped per axis and draw an ellipse.
    -->
    <svg aria-hidden="true" class="pointer-events-none absolute -inset-px size-[calc(100%+2px)] overflow-visible motion-reduce:hidden">
      <rect
        width="100%"
        height="100%"
        rx="28"
        ry="28"
        pathLength="1"
        fill="none"
        stroke-width="1.5"
        stroke-dasharray="1"
        stroke-dashoffset="1"
        class="trace-on-scroll stroke-leaf"></rect>
    </svg>
    <a href="/" class:list={[PILL_BRAND, "inline-flex items-center"]}>
      <Wordmark variant="color" size="header" />
    </a>
    <nav aria-label="Main" class="hidden gap-1 text-sm sm:flex">
      {
        links.map((link) => (
          <a href={link.href} class={PILL_LINK}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <!-- Sign in happens here, in the same flow as onboarding; the iris then hands off to the app. -->
    <FirstMomentDialog client:idle mode="sign-in" continueHref={appUrl} apiUrl={apiUrl} tone="cloud" size="sm" className="rounded-full" />
  </div>
</header>
