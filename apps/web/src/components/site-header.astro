---
import { buttonVariants } from "@ambar/ui/components/button";
import { appUrl } from "@/lib/app-url.ts";

const home = Astro.url.pathname === "/" ? "" : "/";

const links = [
  { href: `${home}#features`, label: "Features" },
  { href: `${home}#platforms`, label: "Platforms" },
  { href: `${home}#pricing`, label: "Pricing" },
];
---

<!--
  Floating glass pill. backdrop-saturate lets photos underneath tint the glass (leaves, sky) like
  looking through resin. Without backdrop-filter support the fill stays nearly opaque for contrast.
-->
<header class="sticky top-3 z-40 px-3">
  <div
    class="relative mx-auto flex h-14 w-fit items-center gap-6 rounded-full border border-ink/5 bg-cloud/90 pr-2.5 pl-6 shadow-[0_0_0_1px_rgb(20_20_20/0.03),0_1px_2px_rgb(20_20_20/0.05),0_8px_24px_rgb(20_20_20/0.06),inset_0_1px_0_rgb(255_255_255/0.7)] supports-[backdrop-filter]:bg-cloud/65 supports-[backdrop-filter]:backdrop-blur-xl supports-[backdrop-filter]:backdrop-saturate-150"
  >
    <!--
      Reading progress: the pill's own edge is traced in leaf as the page scrolls.
      The pill is h-14 (56px) so the capsule radius is exact: rx = ry = 28. A large rx would be
      clamped per axis and draw an ellipse.
    -->
    <svg aria-hidden="true" class="pointer-events-none absolute -inset-px size-[calc(100%+2px)] overflow-visible motion-reduce:hidden">
      <rect
        width="100%"
        height="100%"
        rx="28"
        ry="28"
        pathLength="1"
        fill="none"
        stroke-width="1.5"
        stroke-dasharray="1"
        stroke-dashoffset="1"
        class="trace-on-scroll stroke-leaf"></rect>
    </svg>
    <a
      href="/"
      class="mr-6 rounded-full font-heading text-xl font-bold tracking-tight text-foreground outline-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid focus-visible:outline-ring"
    >
      Ámbar
    </a>
    <nav aria-label="Main" class="hidden gap-1 text-sm sm:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3.5 py-1.5 text-muted-foreground outline-hidden transition-[color,background-color] duration-200 hover:bg-ink/5 hover:text-foreground focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-ring motion-reduce:transition-none"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a href={`${appUrl}/login`} class={buttonVariants({ tone: "cloud", size: "sm", className: "rounded-full" })}>Sign in</a>
  </div>
</header>
