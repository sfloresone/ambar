# Landing configuration. Copy to .env.local for local overrides (gitignored).
# Everything here is public: it ends up in the page's JavaScript. Never put secrets here; they live in
# apps/api. Validated by the schema in astro.config.ts.

# Where the web app lives ("Start keeping" and "Sign in" end there).
PUBLIC_APP_URL=http://localhost:5173

# Ambar API. Leave commented to use the mock (code 123456, no emails).
# PUBLIC_API_URL=http://localhost:8080
