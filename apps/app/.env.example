# App configuration. Copy to .env.local for local overrides (gitignored).
# Everything here is public: it ends up in the app's JavaScript. Never put secrets here; they live in
# apps/api. Validated by src/env.ts when dev or build starts.

# Ambar API. Leave commented to use the mock (code 123456, no emails).
# VITE_API_URL=http://localhost:8080
