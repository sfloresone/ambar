# Ambar API configuration. Copy to .env.local for local overrides (loaded by main.go, gitignored); on the VPS set these in
# the service environment. Defaults work for development.

# Where the API listens. Behind a reverse proxy keep it on localhost.
ADDR=127.0.0.1:8080

# Postgres connection string. Defaults to the compose.yaml database.
DATABASE_URL=postgres://ambar:ambar@localhost:5432/ambar?sslmode=disable

# The app that receives the sign-in link (APP_URL/login?verify=…). An https URL means production:
# AUTH_SECRET, RESEND_API_KEY and MAIL_FROM become required and the session cookie is Secure.
APP_URL=http://localhost:5173

# Browser origins allowed to call the API with the session cookie (landing, app), comma-separated.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173

# Session cookie domain. Production: .ambar.app (landing, app and api share it). Empty = host-only.
COOKIE_DOMAIN=

# At least 32 random characters (e.g. openssl rand -base64 48). Keys the sign-in code hashes.
# Development generates one per run when unset.
AUTH_SECRET=

# Resend API key and sender. Unset in development: sign-in emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=Ambar <hello@ambar.one>

# true only if the API is reachable solely through our reverse proxy, which must set X-Real-IP.
# Otherwise clients could spoof their IP and dodge the rate limits.
TRUST_PROXY=false

# text (development) or json (VPS log collector).
LOG_FORMAT=text
