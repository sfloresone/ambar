# Copy to .env.local (gitignored). On the VPS, set these in the service environment. ADDR, DATABASE_URL, APP_URL and ALLOWED_ORIGINS are required; API_URL too when a sign-in provider is set.

# Listen address; keep it on localhost behind the reverse proxy.
ADDR=127.0.0.1:8080

# Postgres URL; this one is the compose.yaml database.
DATABASE_URL=postgres://ambar_dev:ambar_dev@localhost:5432/ambar_dev?sslmode=disable

# App that opens the email link; an https URL means production (secrets below become required).
APP_URL=http://localhost:5173

# Public base URL of this API, exactly as registered at Google/GitHub (callback: API_URL/v1/auth/oauth/<provider>/callback).
API_URL=http://localhost:8080

# Google OAuth web client credentials. Leave both blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app credentials. Leave both blank to disable GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173

# 32+ random characters (openssl rand -base64 48); unset in dev = a new one per run.
AUTH_SECRET=

# Resend API key; unset = emails are printed to the console.
RESEND_API_KEY=

# Sender address; its domain must be verified in Resend.
MAIL_FROM=Ambar <hi@ambar.page>

# true only when the reverse proxy is the sole way in and sets X-Real-IP.
TRUST_PROXY=false

# text (dev) or json (VPS).
LOG_FORMAT=text
