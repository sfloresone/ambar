{
  "name": "ambar",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "dev:web": "bun --filter @ambar/web dev",
    "dev:app": "bun --filter @ambar/app dev",
    "build": "bun --filter './apps/*' build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.86.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
